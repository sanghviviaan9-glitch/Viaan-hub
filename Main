-------------------------------------------------
-- Snowflake particles
-------------------------------------------------
local function CreateSnowflake(parent)
    local flake = Instance.new("Frame")
    flake.Size = UDim2.new(0, math.random(3, 8), 0, math.random(3, 8))
    flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
    flake.BackgroundColor3 = Color3.fromRGB(200, 230, 255)
    flake.BackgroundTransparency = math.random(20, 50) / 100
    flake.BorderSizePixel = 0
    flake.ZIndex = 1
    flake.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = flake

    local speed = math.random(25, 55) / 10
    local drift = (math.random() - 0.5) * 0.4
    local startX = flake.Position.X.Scale

    table.insert(SnowflakeParts, flake)

    task.spawn(function()
        local t = 0
        while flake and flake.Parent do
            t = t + 0.016
            local y = (t * speed * 0.015) % 1.15
            local x = startX + math.sin(t * 1.5) * drift
            flake.Position = UDim2.new(x, 0, y - 0.05, 0)
            flake.Rotation = t * 40
            if y > 1.1 then
                t = 0
                startX = math.random()
            end
            task.wait(0.016)
        end
    end)
end

local function SpawnSnowflakes(parent, count)
    for i = 1, count do
        task.delay(i * 0.05, function()
            if parent and parent.Parent then
                CreateSnowflake(parent)
            end
        end)
    end
end

-------------------------------------------------
-- Utility
-------------------------------------------------
local function MakeCorner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = obj
    return c
end

local function MakeStroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Border
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

local function Tween(obj, props, time)
    local tw = TweenService:Create(obj, TweenInfo.new(time or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

