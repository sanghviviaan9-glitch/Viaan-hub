-------------------------------------------------
-- TOGGLE CREATOR
-------------------------------------------------
local function CreateToggle(name, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = Theme.Secondary
    row.BorderSizePixel = 0
    row.ZIndex = 5
    row.Parent = Content
    MakeCorner(row, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 6
    label.Parent = row

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 42, 0, 22)
    toggle.Position = UDim2.new(1, -52, 0.5, -11)
    toggle.BackgroundColor3 = default and Theme.Accent or Theme.Tertiary
    toggle.Text = ""
    toggle.AutoButtonColor = false
    toggle.ZIndex = 6
    toggle.Parent = row
    MakeCorner(toggle, 11)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 7
    knob.Parent = toggle
    MakeCorner(knob, 8)

    local on = default
    toggle.MouseButton1Click:Connect(function()
        on = not on
        Tween(toggle, {BackgroundColor3 = on and Theme.Accent or Theme.Tertiary}, 0.2)
        Tween(knob, {Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}, 0.2)
        if callback then callback(on) end
    end)

    return row
end

local function CreateSection(text)
    local s = Instance.new("TextLabel")
    s.Size = UDim2.new(1, 0, 0, 22)
    s.BackgroundTransparency = 1
    s.Text = text
    s.TextColor3 = Theme.Accent
    s.Font = Enum.Font.GothamBold
    s.TextSize = 12
    s.TextXAlignment = Enum.TextXAlignment.Left
    s.ZIndex = 5
    s.Parent = Content
    return s
end

