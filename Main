-------------------------------------------------
-- ANTICHEAT DISABLER (Viaan Smooth)
-------------------------------------------------
local ACConnection = nil
local lastStabilize = 0
local STABILIZE_INTERVAL = 0.85
local MAX_HORIZONTAL = 22

local function SetACStatus(on)
    State.ACDisabler = on
    ACStatus.Text = on and "Status: ON" or "Status: OFF"
    ACStatus.TextColor3 = on and Theme.Success or Theme.Danger
end

local function StartACDisabler()
    if ACConnection then return end
    SetACStatus(true)

    ACConnection = RunService.Heartbeat:Connect(function()
        if not State.ACDisabler then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local vel = hrp.AssemblyLinearVelocity
        local horiz = Vector3.new(vel.X, 0, vel.Z)

        if horiz.Magnitude > MAX_HORIZONTAL then
            local limited = horiz.Unit * MAX_HORIZONTAL
            hrp.AssemblyLinearVelocity = Vector3.new(limited.X, vel.Y, limited.Z)
        end

        if hrp.AssemblyAngularVelocity.Magnitude > 1 then
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        local now = tick()
        if now - lastStabilize >= STABILIZE_INTERVAL then
            lastStabilize = now

            local newY = math.clamp(vel.Y, -35, 50)
            local currentHoriz = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
            if currentHoriz.Magnitude > 0.5 then
                currentHoriz = currentHoriz.Unit * math.min(currentHoriz.Magnitude, MAX_HORIZONTAL)
            end

            hrp.AssemblyLinearVelocity = Vector3.new(currentHoriz.X, newY, currentHoriz.Z)
            hrp.AssemblyAngularVelocity = Vector3.zero

            pcall(function()
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Freefall then
                    local ray = Workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0))
                    if ray then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                elseif st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end
    end)
end

local function StopACDisabler()
    SetACStatus(false)
    if ACConnection then
        ACConnection:Disconnect()
        ACConnection = nil
    end
end

ACEnableBtn.MouseButton1Click:Connect(StartACDisabler)
ACDisableBtn.MouseButton1Click:Connect(StopACDisabler)

-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function GetClosestEnemy(range)
    local closest = nil
    local closestDist = range or 20
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr \~= LocalPlayer and plr.Character then
            local eHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            local eHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if eHRP and eHum and eHum.Health > 0 then
                local dist = (hrp.Position - eHRP.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = plr
                end
            end
        end
    end
    return closest, closestDist
end

-------------------------------------------------
-- SMOOTH 140 SPEED (no lagback / no TP-back)
-------------------------------------------------
local function ApplySmoothSpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    if not State.Speed then
        if hum.WalkSpeed > 20 then
            hum.WalkSpeed = 16
        end
        return
    end

    hum.WalkSpeed = 16

    local moveDir = hum.MoveDirection
    if moveDir.Magnitude < 0.1 then
        local vel = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.85, vel.Y, vel.Z * 0.85)
        return
    end

    local targetVel = moveDir.Unit * State.SpeedValue
    local current = hrp.AssemblyLinearVelocity
    local smooth = current:Lerp(Vector3.new(targetVel.X, current.Y, targetVel.Z), 0.35)

    local horiz = Vector3.new(smooth.X, 0, smooth.Z)
    if horiz.Magnitude > State.SpeedValue + 5 then
        horiz = horiz.Unit * State.SpeedValue
        smooth = Vector3.new(horiz.X, smooth.Y, horiz.Z)
    end

    hrp.AssemblyLinearVelocity = smooth
    hrp.AssemblyAngularVelocity = Vector3.zero
end

-------------------------------------------------
-- TARGET STRAFE
-------------------------------------------------
local function ApplyTargetStrafe()
    if not State.TargetStrafe then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = GetClosestEnemy(State.TargetStrafeRange)
    if not target or not target.Character then return end
    local eHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not eHRP then return end

    strafeAngle = strafeAngle + 0.07
    local offset = Vector3.new(math.cos(strafeAngle) * 6, 0, math.sin(strafeAngle) * 6)
    local desired = eHRP.Position + offset
    local dir = (desired - hrp.Position)
    dir = Vector3.new(dir.X, 0, dir.Z)

    if dir.Magnitude > 0.5 then
        local vel = dir.Unit * State.TargetStrafeSpeed
        local current = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(vel.X, current.Y, vel.Z)
    end
end

-------------------------------------------------
-- VAPE-STYLE KILL AURA
-- 32 stud reach + auto face + keep distance so they can't hit you
-------------------------------------------------
local function ApplyKillAura()
    if not State.KillAura then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildOfClass("Tool")
    if not hrp or not hum or hum.Health <= 0 then return end

    local target, dist = GetClosestEnemy(State.KillAuraRange)
    if not target or not target.Character then return end

    local eHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local eHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not eHRP or not eHum or eHum.Health <= 0 then return end

    -- Face the target
    local lookAt = CFrame.lookAt(hrp.Position, Vector3.new(eHRP.Position.X, hrp.Position.Y, eHRP.Position.Z))
    hrp.CFrame = hrp.CFrame:Lerp(lookAt, 0.35)

    -- Keep safe gap so enemy melee can't reach you
    local safeDist = 11
    if dist < safeDist then
        local away = (hrp.Position - eHRP.Position)
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude > 0.1 then
            local push = away.Unit * 18
            local cur = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(push.X, cur.Y, push.Z)
        end
    end

    -- Attack
    pcall(function()
        if tool then
            tool:Activate()
        end
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new())
    end)
end

-------------------------------------------------
-- AUTO CLICKER
-------------------------------------------------
local function ApplyAutoClicker()
    if not State.AutoClicker then return end
    local now = tick()
    local interval = 1 / math.max(State.AutoClickerCPS, 1)
    if now - lastClick < interval then return end
    lastClick = now

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new())
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
        end
    end)
end

-------------------------------------------------
-- ESP
-------------------------------------------------
local function CreateESP(plr)
    if plr == LocalPlayer then return end
    if ESPObjects[plr] then return end

    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ViaanESP"
    highlight.FillColor = Color3.fromRGB(255, 60, 80)
    highlight.OutlineColor = Color3.fromRGB(255, 200, 200)
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ViaanName"
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = hrp
    billboard.Parent = hrp

    local nameTag = Instance.new("TextLabel")
    nameTag.Size = UDim2.new(1, 0, 1, 0)
    nameTag.BackgroundTransparency = 1
    nameTag.Text = plr.Name
    nameTag.TextColor3 = Color3.fromRGB(255, 220, 220)
    nameTag.Font = Enum.Font.GothamBold
    nameTag.TextSize = 12
    nameTag.TextStrokeTransparency = 0.5
    nameTag.Parent = billboard

    ESPObjects[plr] = {highlight = highlight, billboard = billboard}

    plr.CharacterAdded:Connect(function()
        task.wait(0.6)
        if State.ESP then
            if ESPObjects[plr] then
                if ESPObjects[plr].highlight then ESPObjects[plr].highlight:Destroy() end
                if ESPObjects[plr].billboard then ESPObjects[plr].billboard:Destroy() end
                ESPObjects[plr] = nil
            end
            CreateESP(plr)
        end
    end)
end

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if not State.ESP then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr \~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPObjects[plr] then
                CreateESP(plr)
            end
        end
    end
end))

Players.PlayerRemoving:Connect(function(plr)
    if ESPObjects[plr] then
        if ESPObjects[plr].highlight then ESPObjects[plr].highlight:Destroy() end
        if ESPObjects[plr].billboard then ESPObjects[plr].billboard:Destroy() end
        ESPObjects[plr] = nil
    end
end)

-------------------------------------------------
-- MAIN HEARTBEAT
-------------------------------------------------
table.insert(Connections, RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    ApplySmoothSpeed()
    ApplyTargetStrafe()
    ApplyKillAura()
    ApplyAutoClicker()

    if State.Jump then
        hum.JumpPower = State.JumpValue
        hum.UseJumpPower = true
    end

    if State.Fly then
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = dir.Unit * 50
        else
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if State.Noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end))

-------------------------------------------------
-- CHARACTER RESPAWN SAFETY
-------------------------------------------------
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if State.ACDisabler then
        StopACDisabler()
        task.wait(0.3)
        StartACDisabler()
    end
end)

print("[Viaan Hub] Loaded | Smooth 140 Speed | Vape KillAura 32 stud | TargetStrafe | AutoClicker | AC Disabler")
